<?xml version="1.0"?>
<package format="2">
  <name>message_generation</name>
  <version>0.4.1</version>
  <description>Package modeling the build-time dependencies for generating language bindings of messages.</description>
  <maintainer email="dthomas@osrfoundation.org">Dirk Thomas</maintainer>
  <license>BSD</license>

  <url>http://ros.org/wiki/message_generation</url>
  <url type="bugtracker">https://github.com/ros/message_generation/issues</url>
  <url type="repository">https://github.com/ros/message_generation</url>

  <buildtool_depend>catkin</buildtool_depend>

  <build_export_depend>gencpp</build_export_depend>
  <build_export_depend>geneus</build_export_depend>
  <build_export_depend>gennodejs</build_export_depend>
  <build_export_depend>genlisp</build_export_depend>
  <build_export_depend>genmsg</build_export_depend>
  <build_export_depend>genpy</build_export_depend>
</package>
